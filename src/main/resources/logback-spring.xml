<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_BASE" value="logs"/>
    <property name="PAT_ALL"     value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %-50logger{50} | %msg%n"/>
    <property name="PAT_ERROR"   value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %-50logger{50} | %msg%n%xEx{full}"/>
    <property name="PAT_CONSOLE" value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- ================================================================
         ADMIN サブパッケージ別 appender（all + error）
         各フォルダ：logs/admin/{subpackage}/admin-{name}-YYYY-MM-DD.log
                                             admin-{name}-error-YYYY-MM-DD.log
    ================================================================ -->

    <appender name="ADMIN_AUTH" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_BASE}/admin/auth/admin-auth-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${PAT_ALL}</pattern><charset>UTF-8</charset></encoder>
    </appender>
    <appender name="ADMIN_AUTH_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>ERROR</level></filter>
